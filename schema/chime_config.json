{
  "schema_version": 7,
  "legacy_unversioned": 4,
  "version_notes": "Ring volume is `volume_ring`; notification volume is `volume_notifications`. Shipped MQTT topics follow Ring's `ring/<unit>/pressed/<n>` and `ring/<unit>/status` scheme.",
  "unknown_key_policy": "preserve",
  "unknown_key_policy_notes": "Unknown assignment keys and comments are kept as written. Removed keys are dropped. Missing known keys are filled with schema defaults during migration.",
  "removed": {
    "5": [
      {
        "key": "volume_other",
        "reason": "Persisted and shown in the UI but never consumed by the audio path. Ring playback uses volume_ring; notification playback uses volume_notifications. There is no third audio category."
      }
    ],
    "6": [],
    "7": []
  },
  "migrations": [
    {
      "to": 5,
      "remove": ["volume_other"],
      "rename": []
    },
    {
      "to": 6,
      "remove": [],
      "rename": [{ "from": "volume_bell", "to": "volume_ring" }]
    },
    {
      "to": 7,
      "remove": [],
      "rename": [],
      "replace": [
        { "key": "mqtt_topics", "from": "ring/pressed,ring/status", "to": "ring/+/pressed/#,ring/+/status" },
        { "key": "ring_topic", "from": "ring/pressed", "to": "ring/+/pressed/#" }
      ]
    }
  ],
