#!/bin/sh
# The root filesystem is read-only. post_build.sh points the mutable paths
# (/etc/ring.conf, wpa_supplicant.conf, /etc/dropbear) at /etc/persistent;
# this script seeds /data from the factory copies and bind-mounts it there.

FACTORY_DIR="/usr/local/share/openchime/factory"

copy_if_missing() {
    SRC="$1"
    DST="$2"
    if [ ! -e "$DST" ] && [ -e "$SRC" ]; then
        mkdir -p "$(dirname "$DST")"
        cp -p "$SRC" "$DST"
    fi
}

bind_dir() {
    SRC="$1"
    DST="$2"
    mkdir -p "$SRC"
    if grep -q " $DST " /proc/mounts; then
        return 0
    fi
    mount --bind "$SRC" "$DST"
}

start() {
    printf "Starting persistent overlay: "

    if ! grep -q " /data " /proc/mounts; then
        echo "FAIL (/data not mounted)"
        return 0
    fi

    mkdir -p /data/etc/dropbear /data/var/lib/ring /data/var/lib/bluetooth /data/var/log /data/ota
    chmod 700 /data/etc/dropbear /data/var/lib/bluetooth
    copy_if_missing "$FACTORY_DIR/ring.conf" /data/etc/ring.conf
    copy_if_missing "$FACTORY_DIR/wpa_supplicant.conf" /data/etc/wpa_supplicant.conf

    failed=""
    bind_dir /data/etc /etc/persistent || failed="$failed /etc/persistent"
    bind_dir /data/var/lib/ring /var/lib/ring || failed="$failed /var/lib/ring"
    bind_dir /data/var/lib/bluetooth /var/lib/bluetooth || failed="$failed /var/lib/bluetooth"

    if [ -n "$failed" ]; then
        echo "FAIL (bind:$failed)"
    else
        echo "OK"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
